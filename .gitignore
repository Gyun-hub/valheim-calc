# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# 채팅 첨부로 프로젝트 루트에 떨어진 참고용 이미지 (서드파티 출처, 재배포 대상 아님)
/*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code 개인 권한 설정 (사용자별)
.claude/settings.local.json
